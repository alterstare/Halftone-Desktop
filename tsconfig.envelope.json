{
  // The embedded Envelope renderer (src/envelope, synced from ../doujin_player):
  // checked on its own because its window.api is Envelope's API, not Halftone's.
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "./out/types-envelope"
  },
  "include": ["src/renderer/envelope-main.ts", "src/envelope/renderer/src/**/*", "src/envelope/shared/**/*", "src/envelope/preload/index.d.ts"]
}
